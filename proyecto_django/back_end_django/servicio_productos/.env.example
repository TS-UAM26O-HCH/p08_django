DEBUG=True
SECRET_KEY=cambiar-por-una-clave-segura-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1,servicio_productos
# Prefijo con el que el gateway expone este servicio.
# En Docker (vía gateway) usar /api/productos. En local sin gateway dejar vacío.
FORCE_SCRIPT_NAME=/api/productos

DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=productos_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=postgres_productos
DATABASE_PORT=5432
