DEBUG=True
SECRET_KEY=cambiar-por-una-clave-segura-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1,servicio_auth
# Prefijo con el que el gateway expone este servicio.
# En Docker (vía gateway) usar /api/auth. En local sin gateway dejar vacío.
FORCE_SCRIPT_NAME=/api/auth

DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=auth_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=postgres_auth
DATABASE_PORT=5432
