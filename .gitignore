*.sage.py

# dotenv
.env

# Microservicios: la llave PRIVADA JWT nunca se commitea
# (solo servicio_auth/keys/private.pem la posee; el resto usa public.pem)
**/keys/private.pem

# virtualenv
.venv
venv/
ENV/
.vscode
